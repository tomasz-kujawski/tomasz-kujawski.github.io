DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector_2 }    INPUT  FEATURE_TYPE COG_COG_2    ENGINE { SOURCE "" DESTINATION "EUREF89.NTM-10" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_2_REPROJECTED          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { RasterPropertyExtractor }    INPUT  FEATURE_TYPE Reprojector_2_REPROJECTED    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    FUNCTION_DEFINITION { @RasterProperties(REJECTABLE, RASTER_ROTATION2D) }    OUTPUT { COMPLETE FEATURE_TYPE RasterPropertyExtractor_OUTPUT        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} RasterEvaluationFactory    FACTORY_NAME { RasterExpressionEvaluator }    INPUT A FEATURE_TYPE RasterPropertyExtractor_OUTPUT    INTERPRETATION_LIST "AUTO" EXPRESSION_LIST "if<openparen>A<openbracket>0<closebracket><gt>6.5<comma><space>1<comma><space>0<closeparen>"    FORCE_FLOAT_DIVISION yes    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    ATTRIBUTE_ACCUMULATION_MODE { <Unused> }    ATTRIBUTE_CONFLICT_RESOLUTION { <Unused> }    REJECT_INVALID_FEATURES YES    OUTPUT { RESULT FEATURE_TYPE RasterExpressionEvaluator_RESULT          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector_3 }    INPUT  FEATURE_TYPE el_transformatorstasjon_GEODATABASE_FILE_2    ENGINE { SOURCE "" DESTINATION "EUREF89.NTM-10" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_3_REPROJECTED          }
# -------------------------------------------------------------------------
# 20210313 - Use Macros to engage/disengage the solid vs. 2d buffering rather than a runtime
# check to reduce processing overhead
INCLUDE [if { ("JOIN_ARC" == "JOIN_MITER") } {         } else {             puts "MACRO MITER_TO_USE 0"         };         if { ("AREA" == "SOLID") } {             puts "MACRO SOLIDFACTORYENGAGED *";             puts "MACRO DISSOLVEFACTORYENGAGED NO";         } else {             puts "MACRO SOLIDFACTORYENGAGED NO";             puts "MACRO DISSOLVEFACTORYENGAGED *";         };         ]
#
# This is the AREA part of the buffering:
#
FACTORY_DEF {$(DISSOLVEFACTORYENGAGED)} PolygonDissolveFactory    FACTORY_NAME { Bufferer_2DBuffering }    INPUT  FEATURE_TYPE Reprojector_3_REPROJECTED    FLUSH_WHEN_GROUPS_CHANGE { No }    REJECT_INVALID_GEOM Yes    USE_AZMED_NEIGHBORHOOD Yes    PRE_BUFFER { "2000" "22.5" "CAP_ARC" "JOIN_ARC" "$(MITER_TO_USE)" FULL OFFSET_UNITS "METERS" PRECISION "APPROX" }    DISSOLVE_MODE GEOS    CLEANING_TOLERANCE { AUTO }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    OUTPUT { POLYGON FEATURE_TYPE Bufferer_BUFFERED         }    OUTPUT { NON_POLYGON FEATURE_TYPE Bufferer_BUFFERED         }
#
# This is the SOLID part of the buffering:
#
FACTORY_DEF {$(SOLIDFACTORYENGAGED)} SolidBufferingFactory    FACTORY_NAME { Bufferer_3DBuffering }    INPUT  FEATURE_TYPE Reprojector_3_REPROJECTED    SPHERE_RADIUS { "2000" }    SPHERE_DIVISIONS { "<Unused>" }    OUTPUT { BUFFERED FEATURE_TYPE Bufferer_BUFFERED        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} PolygonDissolveFactory    FACTORY_NAME { Dissolver }    INPUT  FEATURE_TYPE Bufferer_BUFFERED    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    DEAGGREGATE_INPUT { Yes }    MODE COMPLETE    CONNECT_Z_MODE { FIRST_WINS }    CLEANING_TOLERANCE { AUTO }    ACCUM_INPUT_ATTRS { One }    CALCULATE_STATS_ON_DEAGGREGATED NO    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    OUTPUT_REMNANTS    OUTPUT { POLYGON FEATURE_TYPE Dissolver_AREA         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { 3DForcer }    INPUT  FEATURE_TYPE Dissolver_AREA    OUTPUT { FEATURE_TYPE ___TOREJECTOR___         @ZValue("1", "No", ___fme_rejection_code___) }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { 3DForcer_Rejector }    INPUT FEATURE_TYPE ___TOREJECTOR___    TEST @Value(___fme_rejection_code___) != ""    OUTPUT { FAILED FEATURE_TYPE 3DForcer_OUTPUT          }
# -------------------------------------------------------------------------
INCLUDE [    if { ([string equal {<Unused>} {<Unused>}]==0 && [string equal {<Unused>} {<not set>}]==0) &&         ([string equal {<Unused>} {<Unused>}]==0 && [string equal {<Unused>} {<not set>}]==0) &&         ([string equal {<Unused>} {<Unused>}]==0 && [string equal {<Unused>} {<not set>}]==0) &&         ([string equal {<Unused>} {<Unused>}]==0 && [string equal {<Unused>} {<not set>}]==0)}    {       puts {MACRO GROUND_EXTENTS_CLAUSE GROUND_EXTENTS_MIN_X "<Unused>"                                         GROUND_EXTENTS_MIN_Y "<Unused>"                                         GROUND_EXTENTS_MAX_X "<Unused>"                                         GROUND_EXTENTS_MAX_Y "<Unused>"};    }    elseif { ([string equal {<Unused>} {<Unused>}] || [string equal {<Unused>} {<not set>}]) &&             ([string equal {<Unused>} {<Unused>}] || [string equal {<Unused>} {<not set>}]) &&             ([string equal {<Unused>} {<Unused>}] || [string equal {<Unused>} {<not set>}]) &&             ([string equal {<Unused>} {<Unused>}] || [string equal {<Unused>} {<not set>}])}    {       puts {MACRO GROUND_EXTENTS_CLAUSE};    }    else    {        puts_real {NumericRasterizer (NumericRasterizer): To specify Ground Extents, all the Ground Extents parameters must be filled out.}; exit 1;    } ]
FACTORY_DEF {*} VectorToRasterFactory    FACTORY_NAME { NumericRasterizer }    INPUT  FEATURE_TYPE 3DForcer_OUTPUT    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    WIDTH { "1763" }    HEIGHT { "2322" }    X_CELL_SIZE { "<Unused>" }    Y_CELL_SIZE { "<Unused>" }    INTERPRETATION_TYPE { REAL64 }    BACKGROUND_VALUE { "0" }    FILL_WITH_NODATA { Yes }    ANTI_ALIASING { No }    TOLERANCE { 0.5 }    $(GROUND_EXTENTS_CLAUSE)    REJECT_INVALID_GEOM YES    OUTPUT { RASTER FEATURE_TYPE NumericRasterizer_RASTER       @SupplyAttributes(?,fme_basename,NumericRasterizer)        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} RasterSegmentationFactory    FACTORY_NAME { RasterToPolygonCoercer }    INPUT  FEATURE_TYPE NumericRasterizer_RASTER    POLYGON_MODE UNIQUE    EXTRACT_NODATA { No }    PRESERVE_ATTRIBUTES { YES }    POLYGON_LABEL_ATTRIBUTE { "_label" }    REJECT_INVALID_FEATURES YES    OUTPUT { POLYGONS FEATURE_TYPE RasterToPolygonCoercer_POLYGONS        }
# -------------------------------------------------------------------------
