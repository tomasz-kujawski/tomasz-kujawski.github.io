FACTORY_DEF {*} VectorToRasterFactory    FACTORY_NAME { NumericRasterizer_2 }    INPUT  FEATURE_TYPE 3DForcer_2_OUTPUT    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    WIDTH { "1763" }    HEIGHT { "2322" }    X_CELL_SIZE { "<Unused>" }    Y_CELL_SIZE { "<Unused>" }    INTERPRETATION_TYPE { REAL64 }    BACKGROUND_VALUE { "0" }    FILL_WITH_NODATA { Yes }    ANTI_ALIASING { No }    TOLERANCE { 0.5 }    $(GROUND_EXTENTS_CLAUSE)    REJECT_INVALID_GEOM YES    OUTPUT { RASTER FEATURE_TYPE NumericRasterizer_2_RASTER       @SupplyAttributes(?,fme_basename,NumericRasterizer_2)        }
