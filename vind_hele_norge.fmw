DEFAULT_MACRO GEODATABASE_FILE_IN_SIMPLE_DONUT_GEOMETRY_GEODATABASE_FILE_1 no
GEODATABASE_FILE_1_SIMPLE_DONUT_GEOMETRY "$(GEODATABASE_FILE_IN_SIMPLE_DONUT_GEOMETRY_GEODATABASE_FILE_1)"
