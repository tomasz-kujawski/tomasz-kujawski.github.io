DEFAULT_MACRO GEODATABASE_FILE_IN_STRIP_GUID_GLOBALID_BRACES_GEODATABASE_FILE_1 no
GEODATABASE_FILE_1_STRIP_GUID_GLOBALID_BRACES "$(GEODATABASE_FILE_IN_STRIP_GUID_GLOBALID_BRACES_GEODATABASE_FILE_1)"
GUI CHOICE GEODATABASE_FILE_IN_STRIP_GUID_GLOBALID_BRACES_GEODATABASE_FILE_1 yes%no Strip braces off GlobalID and GUID:
